# Fictional defaults for loopback synthetic demos only. Never use in production.
DATABASE_URL=sqlite:///./.local/procurepilot.db
RAG_INDEX_PATH=.local/rag/index.json
BACKEND_URL=http://127.0.0.1:8000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=procurepilot
MYSQL_USER=procurepilot
MYSQL_PASSWORD=procurepilot_dev
MYSQL_ROOT_PASSWORD=root_dev_only

# Offline by default. Only enable after confirming provider, synthetic data and cost.
PP_LLM_MODE=offline
PP_LLM_ALLOW_SYNTHETIC_SEND=false
# Full HTTPS Chat Completions URL; HTTP is permitted only for literal loopback/localhost.
PP_LLM_ENDPOINT=
PP_LLM_MODEL=
# Dedicated backend credential. Never use a VITE_* variable or commit a real key.
PP_LLM_API_KEY=
